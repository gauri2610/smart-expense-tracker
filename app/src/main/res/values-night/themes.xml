<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Dark Mode Theme -->
    <style name="Theme.SmartExpenseTracker.Dark" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Primary Colors -->
        <item name="colorPrimary">@color/primary_dark</item>
        <item name="colorPrimaryVariant">@color/primary_variant_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary Colors -->
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Background -->
        <item name="android:windowBackground">@color/black</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/primary_variant_dark</item>

        <!-- Text Input Style -->
        <item name="textInputStyle">
            @style/Widget.MaterialComponents.TextInputLayout.OutlinedBox
        </item>

        <!-- Button Style -->
        <item name="materialButtonStyle">
            @style/Widget.MaterialComponents.Button
        </item>

    </style>

</resources>